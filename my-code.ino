#define MIC_ADC_CHANNEL ADC1_CHANNEL_7  // entspricht GPIO27
#define SAMPLE_RATE 8000
#define RECORD_SECONDS 5
#define NUM_SAMPLES (SAMPLE_RATE * RECORD_SECONDS)

int16_t* audioBuffer = nullptr;  // wird zur Laufzeit alloziert
size_t audioBufferLen = 0;
void initMicADC() {
  adc1_config_width(ADC_WIDTH_BIT_12);
  adc1_config_channel_atten(MIC_ADC_CHANNEL, ADC_ATTEN_DB_12); // 0-3.3V Bereich
}
bool recordAudio() {
  const size_t bufferBytes = NUM_SAMPLES * sizeof(int16_t);

  // Vorher aufräumen, falls schon was allokiert war
  if (audioBuffer != nullptr) {
    free(audioBuffer);
    audioBuffer = nullptr;
  }

  audioBuffer = (int16_t*) malloc(bufferBytes);
  if (audioBuffer == nullptr) {
    Serial.println("Fehler: Kein RAM für Audio-Buffer frei!");
    return false;
  }

  Serial.println("Aufnahme läuft...");
  const uint32_t sampleIntervalUs = 1000000UL / SAMPLE_RATE;

  for (int i = 0; i < NUM_SAMPLES; i++) {
    uint32_t start = micros();

    int raw = adc1_get_raw(MIC_ADC_CHANNEL);       // 0-4095
    audioBuffer[i] = (int16_t)((raw - 2048) * 16);  // zentrieren + auf 16-bit skalieren

    // Auf exakten Sample-Takt warten
    while (micros() - start < sampleIntervalUs) {
      // busy-wait für stabiles Timing
    }
  }

  audioBufferLen = bufferBytes;
  Serial.println("Aufnahme fertig.");
  return true;
}
uint8_t* buildWavFile(size_t &outLen) {
  const uint32_t dataSize = audioBufferLen;
  const uint32_t fileSize = 36 + dataSize;
  outLen = 44 + dataSize;

  uint8_t* wav = (uint8_t*) malloc(outLen);
  if (wav == nullptr) return nullptr;

  uint8_t header[44] = {
    'R','I','F','F', 0,0,0,0, 'W','A','V','E',
    'f','m','t',' ', 16,0,0,0,       // Subchunk1Size
    1,0,                             // AudioFormat = PCM
    1,0,                             // NumChannels = mono
    0,0,0,0,                         // SampleRate (wird unten gesetzt)
    0,0,0,0,                         // ByteRate
    2,0,                             // BlockAlign
    16,0,                            // BitsPerSample
    'd','a','t','a', 0,0,0,0         // Subchunk2Size
  };

  *(uint32_t*)(header + 4)  = fileSize;
  *(uint32_t*)(header + 24) = SAMPLE_RATE;
  *(uint32_t*)(header + 28) = SAMPLE_RATE * 2; // ByteRate = SampleRate * NumChannels * BitsPerSample/8
  *(uint32_t*)(header + 40) = dataSize;

  memcpy(wav, header, 44);
  memcpy(wav + 44, audioBuffer, dataSize);

  return wav;
}
String sendToGroqSTT(const char* apiKey) {
  size_t wavLen;
  uint8_t* wavData = buildWavFile(wavLen);
  if (wavData == nullptr) {
    return "FEHLER: Konnte WAV nicht bauen";
  }

  HTTPClient http;
  http.begin("https://api.groq.com/openai/v1/audio/transcriptions");
  http.addHeader("Authorization", String("Bearer ") + apiKey);

  String boundary = "----ESP32Boundary";
  String header = "--" + boundary + "\r\n"
    "Content-Disposition: form-data; name=\"model\"\r\n\r\n"
    "whisper-large-v3-turbo\r\n"
    "--" + boundary + "\r\n"
    "Content-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\n"
    "Content-Type: audio/wav\r\n\r\n";
  String footer = "\r\n--" + boundary + "--\r\n";

  size_t totalLen = header.length() + wavLen + footer.length();
  uint8_t* body = (uint8_t*) malloc(totalLen);
  if (body == nullptr) {
    free(wavData);
    return "FEHLER: Kein RAM fürs HTTP-Body";
  }

  size_t pos = 0;
  memcpy(body + pos, header.c_str(), header.length()); pos += header.length();
  memcpy(body + pos, wavData, wavLen); pos += wavLen;
  memcpy(body + pos, footer.c_str(), footer.length()); pos += footer.length();

  http.addHeader("Content-Type", "multipart/form-data; boundary=" + boundary);
  int httpCode = http.POST(body, totalLen);

  String result;
  if (httpCode == 200) {
    result = http.getString();
  } else {
    result = "FEHLER: HTTP " + String(httpCode) + " - " + http.getString();
  }

  free(wavData);
  free(body);
  http.end();
  return result;
}
void freeAudioBuffer() {
  if (audioBuffer != nullptr) {
    free(audioBuffer);
    audioBuffer = nullptr;
    audioBufferLen = 0;
  }
}
