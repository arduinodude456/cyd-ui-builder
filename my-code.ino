#include <ArduinoOTA.h>

void enterFlashMode() {
  Serial.println("Starte Flash-Modus...");

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  Serial.print("Verbinde mit WLAN");

  unsigned long start = millis();

  while (WiFi.status() != WL_CONNECTED) {
    delay(250);
    Serial.print(".");

    // Nach 15 Sekunden abbrechen
    if (millis() - start > 15000) {
      Serial.println("\nWLAN-Verbindung fehlgeschlagen!");
      return;
    }
  }

  Serial.println();
  Serial.println("WLAN verbunden.");
  Serial.print("IP-Adresse: ");
  Serial.println(WiFi.localIP());
  textWindowRunning(String(WiFi.localIP()).c_str());
  ArduinoOTA.setHostname("ESP32-Flash");

  ArduinoOTA.onStart([]() {
    Serial.println("Flash-Vorgang gestartet...");
  });

  ArduinoOTA.onEnd([]() {
    Serial.println("\nFlash-Vorgang abgeschlossen!");
  });

  ArduinoOTA.onProgress([](unsigned int progress, unsigned int total) {
    Serial.printf("Flash: %u%%\r", (progress * 100) / total);
  });

  ArduinoOTA.onError([](ota_error_t error) {
    Serial.printf("\nOTA-Fehler: %u\n", error);
  });

  ArduinoOTA.begin();

  Serial.println("================================");
  Serial.println("ESP32 ist jetzt im Flash-Modus!");
  Serial.println("================================");

  // Im Flash-Modus bleiben
  while (true) {
    ArduinoOTA.handle();
    delay(1);
  }
}


#include <Adafruit_NeoPixel.h>

#define MATRIX_PIN   27
#define MATRIX_LEDS  25
#define MATRIX_W      5
#define MATRIX_H      5

Adafruit_NeoPixel matrix(
  MATRIX_LEDS,
  MATRIX_PIN,
  NEO_GRB + NEO_KHZ800
);


// --------------------------------------------------
// Matrix initialisieren
// --------------------------------------------------

void initMatrix() {
  matrix.begin();
  matrix.setBrightness(40);
  matrix.clear();
  matrix.show();
}


// --------------------------------------------------
// LED-Index für deine Serpentinen-Verdrahtung
// --------------------------------------------------

int matrixIndex(int x, int y) {

  if (x < 0 || x >= MATRIX_W ||
      y < 0 || y >= MATRIX_H)
    return -1;

  // Jede zweite Reihe ist umgedreht
  if (y & 1)
    x = MATRIX_W - 1 - x;

  return y * MATRIX_W + x;
}


