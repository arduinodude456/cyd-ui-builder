  HTTPClient http;
  String url = "https://api.open-meteo.com/v1/forecast?latitude=" + String(latitude, 4)
              + "&longitude=" + String(longitude, 4)
              + "&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code";

  http.begin(url);
  int httpCode = http.GET();

  if (httpCode == 200) {
