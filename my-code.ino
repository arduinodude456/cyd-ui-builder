  0b11110,
  0b10000,
  0b11111
};

const byte fontT[5] = {
  0b11111,
  0b00100,
  0b00100,
  0b00100,
  0b00100
};


// --------------------------------------------------
// Farbe: langsam durch den Farbkreis
// --------------------------------------------------

uint32_t matrixColor(byte hue) {

  if (hue < 85) {
    return matrix.Color(
      255 - hue * 3,
      hue * 3,
      0
    );
  }

  if (hue < 170) {
    hue -= 85;

    return matrix.Color(
      0,
      255 - hue * 3,
      hue * 3
    );
  }

  hue -= 170;

  return matrix.Color(
    hue * 3,
    0,
    255 - hue * 3
  );
}


// --------------------------------------------------
// Einen Buchstaben zeichnen
// --------------------------------------------------

void drawMatrixChar(
  const byte character[5],
  int offsetX,
  uint32_t color
) {

  for (int y = 0; y < 5; y++) {

    for (int x = 0; x < 5; x++) {

      if (character[y] & (1 << (4 - x))) {

        int px = offsetX + x;
        int index = matrixIndex(px, y);

        if (index >= 0)
          matrix.setPixelColor(index, color);
      }
    }
  }
}


// --------------------------------------------------
// "HALLO WELT"
// --------------------------------------------------

void writeHello() {

  static int scroll = MATRIX_W;
  static uint8_t hue = 0;
  static unsigned long lastFrame = 0;

  // 25 FPS
  const unsigned long frameTime = 1000 / 25;

  unsigned long now = millis();

  if (now - lastFrame < frameTime)
    return;

  lastFrame = now;

  // Farbe unabhängig vom Text verändern
  hue++;

  uint32_t color = matrixColor(hue);

  matrix.clear();

  /*
       HALLO WELT

       Jeder Buchstabe = 5 Pixel breit
       + 1 Pixel Abstand
  */

  const byte* text[] = {
    fontH,
    fontA,
    fontL,
    fontL,
    fontO,
    nullptr,
    fontW,
    fontE,
    fontL,
    fontT
  };

  const int textLength = 10;

  for (int i = 0; i < textLength; i++) {

    // Leerzeichen
    if (text[i] == nullptr)
      continue;

    int x = scroll + i * 6;

    drawMatrixChar(
      text[i],
      x,
      color
    );
  }

  matrix.show();

  // Laufschrift
  scroll--;

  // 10 Zeichen × 6 Pixel
  const int textWidth = textLength * 6;

  if (scroll < -textWidth)
    scroll = MATRIX_W;
}
