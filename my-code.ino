  digitalWrite(21, HIGH);
WiFi.begin(ssid, password);
Serial.print("Verbinde mit WLAN");
while (WiFi.status() != WL_CONNECTED) {
  delay(500);
    Serial.print(".");
}
//use getWeather
  SPI.begin(14, 12, 13, 15);
  tft.begin();
  tft.setRotation(1);
  touchscreenSPI.begin(XPT2046_CLK, XPT2046_MISO, XPT2046_MOSI, XPT2046_CS);
  ts.begin(touchscreenSPI);
  ts.setRotation(0);
   
  resolveCity(cityName);
  rainChance = getDailyWeatherValue(0, false, true); weatherTimer_weatherRainChance_msoqdwjy5zxj = millis();
  temperatureMinimum = getDailyWeatherValue(0, false, false); weatherTimer_weatherTemperature_msoqf17cka3a = millis();
  temperatureMaximum = getDailyWeatherValue(0, true, false); weatherTimer_weatherTemperature_msoqg3507efu = millis();
  //updateSpecialWeather(true);
  // Code für setup()
initMatrix();

  drawCurrentPage();
}

void loop() {
  if (ts.tirqTouched() && ts.touched()) {
    TS_Point p = ts.getPoint();
    // Bei falscher Orientierung: Touch-Min/Max im Builder kalibrieren oder X/Y tauschen.
    
int16_t x = map(p.y, 200, 3800, tft.width() - 1, 0);

// p.x wird direkt auf die Y-Achse des Displays gelegt
int16_t y = map(p.x, 200, 3800, 0, tft.height() - 1);

// Begrenzung auf die Display-Pixel (320x240)
x = constrain(x, 0, tft.width() - 1);
y = constrain(y, 0, tft.height() - 1);
int afgf = y ;
int bfgf = x ;
x = 320 - bfgf;
x = x + (0.05*x);
y = 240 - afgf + 4;
if (developerMode) {
tft.fillCircle(x, y, 3, ILI9341_RED);
}
	 if (!touchActive) {
      touchActive = true;
      touchStartX = x;
      touchStartY = y;
    }
    touchLastX = x;
    touchLastY = y;
  } else if (touchActive) {
    touchActive = false;
    handleTouch(touchStartX, touchStartY, touchLastX, touchLastY);
  }
  //updateSpecialWeather();
  
  if (millis() - codeAPI1 > 27000) {
    codeAPI1 = millis();
