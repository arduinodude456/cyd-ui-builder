#define GROQ_RESPONSE_BUFFER_SIZE 256
char groqResponseBuffer[GROQ_RESPONSE_BUFFER_SIZE];

char* askGroq(const char* apiKey, const char* question, const char* sysprompt) {
  WiFiClientSecure client;
  client.setInsecure(); // Für Produktivbetrieb besser Root-CA setzen

  HTTPClient https;
  strcpy(groqResponseBuffer, ""); // Buffer zurücksetzen

  if (https.begin(client, "https://api.groq.com/openai/v1/chat/completions")) {
    https.addHeader("Content-Type", "application/json");
    https.addHeader("Authorization", String("Bearer ") + apiKey);

    JsonDocument doc;
    doc["model"] = "llama-3.3-70b-versatile";
    JsonArray messages = doc["messages"].to<JsonArray>();
	
	    // Systemprompt hinzufügen
    JsonObject systemMsg = messages.add<JsonObject>();
    systemMsg["role"] = "system";
    systemMsg["content"] = sysprompt;
    JsonObject msg = messages.add<JsonObject>();
    msg["role"] = "user";
    msg["content"] = question;

    String requestBody;
    serializeJson(doc, requestBody);

    int httpCode = https.POST(requestBody);

    if (httpCode == HTTP_CODE_OK) {
      String payload = https.getString();

      JsonDocument responseDoc;
      DeserializationError error = deserializeJson(responseDoc, payload);

      if (!error) {
        const char* content = responseDoc["choices"][0]["message"]["content"];
        strncpy(groqResponseBuffer, content, GROQ_RESPONSE_BUFFER_SIZE - 1);
        groqResponseBuffer[GROQ_RESPONSE_BUFFER_SIZE - 1] = '\0';
      } else {
        strcpy(groqResponseBuffer, "Fehler beim Parsen der Antwort");
        Serial.println(error.c_str());
      }
    } else {
      snprintf(groqResponseBuffer, GROQ_RESPONSE_BUFFER_SIZE, "HTTP-Fehler: %d", httpCode);
      Serial.println(https.getString());
    }

    https.end();
  } else {
    strcpy(groqResponseBuffer, "Verbindung zu Groq fehlgeschlagen");
  }

  return groqResponseBuffer;
}
float latitude = 0.0;
float longitude = 0.0;
bool resolveCity(const char* city) {
  HTTPClient http;
  String url = "https://geocoding-api.open-meteo.com/v1/search?name=" + String(city) + "&count=1&language=de";
  http.begin(url);
  int httpCode = http.GET();

  bool success = false;
  if (httpCode == 200) {
    String payload = http.getString();
    JsonDocument doc;
    DeserializationError error = deserializeJson(doc, payload);

    if (!error && doc["results"][0]["latitude"].is<float>()) {
      latitude = doc["results"][0]["latitude"];
      longitude = doc["results"][0]["longitude"];
      Serial.println("Stadt gefunden: " + String(city) 
                      + " (" + String(latitude, 4) + ", " + String(longitude, 4) + ")");
      success = true;
    } else {
      Serial.println("Stadt nicht gefunden!");
    }
  } else {
    Serial.print("Geocoding HTTP-Fehler: ");
    Serial.println(httpCode);
  }

  http.end();
  return success;
}
