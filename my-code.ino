void drawListbox(int16_t x, int16_t y, int16_t w, int16_t h, int16_t rowHeight, const char **items, int itemCount, int selectedIndex, uint16_t bg, uint16_t color, uint16_t selectedColor) {
  tft.fillRect(x, y, w, h, bg);
  tft.drawRect(x, y, w, h, ILI9341_WHITE);
  tft.setTextSize(1);
  for (int i = 0; i < itemCount; i++) {
    int16_t rowY = y + i * rowHeight;
    if (rowY + rowHeight > y + h) break;
    if (i == selectedIndex) tft.fillRect(x + 1, rowY, w - 2, rowHeight, 0x18E3);
    tft.setTextColor(i == selectedIndex ? selectedColor : color);
    tft.setCursor(x + 4, rowY + rowHeight / 2 - 4);
    tft.print(items[i]);
  }
}

void drawMultilineText(int16_t x, int16_t y, int16_t w, const char *text, uint16_t color, uint8_t size, uint8_t lineSpacing) {
  tft.setTextColor(color);
  tft.setTextSize(size);
  int16_t charW = 6 * size;
  int16_t lineH = 8 * size + lineSpacing;
  int16_t maxChars = max((int16_t)1, (int16_t)(w / charW));
  char buffer[161];
  int16_t cursorY = y;
  int16_t len = strlen(text);
  int16_t pos = 0;
  while (pos < len) {
    int16_t lineLen = 0;
    int16_t lastSpace = -1;
    while (pos + lineLen < len && lineLen < maxChars && text[pos + lineLen] != '\n') {
      if (text[pos + lineLen] == ' ') lastSpace = lineLen;
      lineLen++;
    }
    bool brokeOnNewline = (pos + lineLen < len && text[pos + lineLen] == '\n');
    if (!brokeOnNewline && pos + lineLen < len && lastSpace >= 0) lineLen = lastSpace;
    int16_t copyLen = min(lineLen, (int16_t)(sizeof(buffer) - 1));
    strncpy(buffer, text + pos, copyLen);
    buffer[copyLen] = '\0';
    tft.setCursor(x, cursorY);
    tft.print(buffer);
    cursorY += lineH;
    pos += lineLen;
    if (pos < len && (text[pos] == '\n' || text[pos] == ' ')) pos++;
  }
}

