}
bool textToSpeech(const String &text) {
  WiFiClientSecure client;
  client.setInsecure();

  if (!client.connect("api.elevenlabs.io", 443)) {
    Serial.println("FEHLER: Verbindung zu ElevenLabs fehlgeschlagen");
    return false;
  }

  // Anführungszeichen/Backslashes im Text escapen, sonst kaputtes JSON
  String safeText = text;
  safeText.replace("\\", "\\\\");
  safeText.replace("\"", "\\\"");

  String jsonBody = "{\"text\":\"" + safeText + "\",\"model_id\":\"eleven_multilingual_v2\"}";

  String voiceId = "21m00Tcm4TlvDq8ikWAM";  // austauschbar gegen eine andere ElevenLabs-Stimme
  String path = "/v1/text-to-speech/" + voiceId + "?output_format=pcm_16000";

  client.print("POST " + path + " HTTP/1.1\r\n");
  client.print("Host: api.elevenlabs.io\r\n");
  client.print("xi-api-key: sk_1731da587d5e576445d01d32665f8fe7cd1399e3b097329c\r\n");
  client.print("Content-Type: application/json\r\n");
  client.print("Content-Length: " + String(jsonBody.length()) + "\r\n");
  client.print("Connection: close\r\n\r\n");
  client.print(jsonBody);

  // Auf Antwort warten
  unsigned long timeout = millis();
  while (client.connected() && !client.available()) {
    if (millis() - timeout > 15000) {
      Serial.println("FEHLER: Timeout beim Warten auf Antwort");
      client.stop();
      return false;
    }
  }

  // HTTP-Header überspringen (bis zur Leerzeile)
  bool headersDone = false;
  while (client.connected() || client.available()) {
    if (client.available()) {
      String line = client.readStringUntil('\n');
      if (line == "\r") { headersDone = true; break; }
    }
  }
  if (!headersDone) {
    Serial.println("FEHLER: Keine gültige Antwort erhalten");
    client.stop();
    return false;
  }

  // Ab hier kommen rohe PCM-Daten -- häppchenweise direkt an den DAC weiterreichen
  uint8_t chunk[512];
  size_t bytesWritten;
  while (client.connected() || client.available()) {
    if (client.available()) {
      int len = client.read(chunk, sizeof(chunk));
      if (len > 0) {
        i2s_write(I2S_NUM_0, chunk, len, &bytesWritten, portMAX_DELAY);
      }
    }
  }

  client.stop();
  return true;
}
	
