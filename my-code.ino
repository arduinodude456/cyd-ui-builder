void openKeyboard(char* target, uint8_t targetSize) {
  keyboardActive = true;
  keyboardTarget = target;
  keyboardTargetSize = targetSize;
  drawKeyboard();
}

void drawKeyboard() {
  tft.fillRect(0, 96, 320, 144, ILI9341_NAVY);
  int16_t rowY = 98;
  for (uint8_t r = 0; r < 4; r++) {
    const char* row = kbRows[r];
    uint8_t len = strlen(row);
    int16_t keyW = 320 / len;
    for (uint8_t i = 0; i < len; i++) {
      tft.drawRect(i * keyW, rowY, keyW, 22, ILI9341_WHITE);
      tft.setTextColor(ILI9341_WHITE);
      tft.setTextSize(1);
      tft.setCursor(i * keyW + keyW / 2 - 3, rowY + 7);
      tft.print(row[i]);
    }
    rowY += 24;
  }
  tft.drawRect(0, rowY, 90, 22, ILI9341_WHITE);
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(24, rowY + 7); tft.print("<-");
  tft.drawRect(90, rowY, 140, 22, ILI9341_WHITE);
  tft.setCursor(142, rowY + 7); tft.print("LEER");
  tft.drawRect(230, rowY, 90, 22, ILI9341_WHITE);
  tft.setCursor(258, rowY + 7); tft.print("OK");
}

void handleKeyboardTouch(int16_t x, int16_t y) {
  int16_t rowY = 98;
  for (uint8_t r = 0; r < 4; r++) {
    const char* row = kbRows[r];
    uint8_t len = strlen(row);
    int16_t keyW = 320 / len;
    if (y >= rowY && y < rowY + 22) {
      uint8_t i = x / keyW;
      if (i < len) {
        uint8_t pos = strlen(keyboardTarget);
        if (pos < keyboardTargetSize - 1) {
          keyboardTarget[pos] = row[i];
          keyboardTarget[pos + 1] = '\0';
        }
      }
      drawKeyboard();
      return;
    }
    rowY += 24;
  }
  if (y >= rowY && y < rowY + 22) {
    if (x < 90) {
      uint8_t pos = strlen(keyboardTarget);
      if (pos > 0) keyboardTarget[pos - 1] = '\0';
    } else if (x < 230) {
      uint8_t pos = strlen(keyboardTarget);
      if (pos < keyboardTargetSize - 1) {
        keyboardTarget[pos] = ' ';
        keyboardTarget[pos + 1] = '\0';
      }
    } else {
      keyboardActive = false;
      drawCurrentPage();
      return;
    }
  }
  drawKeyboard();
}

